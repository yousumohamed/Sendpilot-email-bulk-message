{% extends 'emails/base.html' %}

{% block title %}Dashboard - Bulk Email Dashboard{% endblock %}

{% block content %}
<div class="mb-4">
    <h1 class="display-5 fw-bold">Dashboard</h1>
    <p class="text-muted">Welcome back, {{ user.username }}! Here's your email campaign overview.</p>
</div>

<!-- Statistics Cards -->
<div class="row g-4 mb-4">
    <div class="col-md-6 col-lg-3">
        <div class="stat-card primary">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Total Emails</p>
                    <h2 class="mb-0">{{ total_emails }}</h2>
                </div>
                <div class="icon">
                    <i class="bi bi-envelope-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card success">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Delivered</p>
                    <h2 class="mb-0">{{ delivered_emails }}</h2>
                </div>
                <div class="icon">
                    <i class="bi bi-check-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card danger">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Failed</p>
                    <h2 class="mb-0">{{ failed_emails }}</h2>
                </div>
                <div class="icon">
                    <i class="bi bi-x-circle-fill"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-6 col-lg-3">
        <div class="stat-card warning">
            <div class="d-flex justify-content-between align-items-center">
                <div>
                    <p class="text-muted mb-1">Pending</p>
                    <h2 class="mb-0">{{ pending_emails }}</h2>
                </div>
                <div class="icon">
                    <i class="bi bi-clock-fill"></i>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card bg-primary text-white">
            <div class="card-body p-4 text-center">
                <h2 class="display-6 fw-bold mb-0">
                    {% if total_emails > 0 %}
                    {% widthratio delivered_emails total_emails 100 %}%
                    {% else %}
                    0%
                    {% endif %}
                </h2>
                <p class="mb-0 opacity-75">Overall Delivery Success Rate</p>
            </div>
        </div>
    </div>
</div>

<!-- Charts and Recent Campaigns -->
<div class="row g-4">
    <!-- Delivery Rate Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-pie-chart-fill"></i> Delivery Rate
            </div>
            <div class="card-body d-flex flex-column align-items-center justify-content-center">
                <div style="position: relative; height: 300px; width: 100%;">
                    <canvas id="deliveryChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Emails Per Day Chart -->
    <div class="col-lg-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="bi bi-graph-up"></i> Emails Sent (Last 7 Days)
            </div>
            <div class="card-body">
                <div style="position: relative; height: 300px; width: 100%;">
                    <canvas id="emailsPerDayChart"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Recent Campaigns -->
    <div class="col-12">
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-megaphone-fill"></i> Recent Campaigns</span>
                <a href="{% url 'campaigns' %}" class="btn btn-sm btn-light text-dark">View All</a>
            </div>
            <div class="card-body">
                {% if recent_campaigns %}
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Campaign Name</th>
                                <th>Status</th>
                                <th>Total</th>
                                <th>Sent</th>
                                <th>Failed</th>
                                <th>Created</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for campaign in recent_campaigns %}
                            <tr>
                                <td class="fw-bold">{{ campaign.name }}</td>
                                <td>
                                    {% if campaign.status == 'completed' %}
                                    <span class="badge bg-success">Completed</span>
                                    {% elif campaign.status == 'in_progress' %}
                                    <span class="badge bg-info">In Progress</span>
                                    {% elif campaign.status == 'failed' %}
                                    <span class="badge bg-danger">Failed</span>
                                    {% else %}
                                    <span class="badge bg-warning">Pending</span>
                                    {% endif %}
                                </td>
                                <td>{{ campaign.total_emails }}</td>
                                <td>{{ campaign.sent_emails }}</td>
                                <td>{{ campaign.failed_emails }}</td>
                                <td>{{ campaign.created_at|date:"M d, Y" }}</td>
                                <td>
                                    <a href="{% url 'campaign_detail' campaign.pk %}"
                                        class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i> View
                                    </a>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-muted" style="font-size: 4rem;"></i>
                    <p class="text-muted mt-3">No campaigns yet. Start by sending your first email!</p>
                    <a href="{% url 'send_email' %}" class="btn btn-primary">
                        <i class="bi bi-send-fill"></i> Send Email
                    </a>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>
{% endblock %}

{% block extra_js %}
<script>
    document.addEventListener('DOMContentLoaded', function () {
        // Delivery Rate Doughnut Chart
        const deliveryCanvas = document.getElementById('deliveryChart');
        if (deliveryCanvas) {
            const deliveryCtx = deliveryCanvas.getContext('2d');

            // Check if we have data to display
            const delivered = {{ delivered_emails|default: 0
        }
    };
    const failed = {{ failed_emails|default: 0 }};
    const pending = {{ pending_emails|default: 0 }};
    const total = delivered + failed + pending;

    // If no data, show a placeholder-like state or empty chart
    const chartData = total > 0 ? [delivered, failed, pending] : [0, 0, 1];
    const chartColors = total > 0 ?
        ['rgba(16, 185, 129, 0.8)', 'rgba(239, 68, 68, 0.8)', 'rgba(245, 158, 11, 0.8)'] :
        ['#ddd', '#ddd', '#eee'];

    new Chart(deliveryCtx, {
        type: 'doughnut',
        data: {
            labels: ['Delivered', 'Failed', 'Pending'],
            datasets: [{
                data: chartData,
                backgroundColor: chartColors,
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    position: 'bottom',
                    labels: {
                        padding: 20
                    }
                }
            },
            layout: {
                padding: 10
            }
        }
    });
        }

    // Emails Per Day Line Chart
    const emailsCanvas = document.getElementById('emailsPerDayChart');
    if (emailsCanvas) {
        const emailsPerDayCtx = emailsCanvas.getContext('2d');

        // Safely parse the JSON data
        const emailsPerDayData = {{ emails_per_day| safe
    }};

    const dates = emailsPerDayData.map(item => {
        const date = new Date(item.date);
        return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
    });
    const counts = emailsPerDayData.map(item => item.count);

    new Chart(emailsPerDayCtx, {
        type: 'line',
        data: {
            labels: dates,
            datasets: [{
                label: 'Emails Sent',
                data: counts,
                borderColor: 'rgba(79, 70, 229, 1)',
                backgroundColor: 'rgba(79, 70, 229, 0.1)',
                tension: 0.4,
                fill: true,
                pointBackgroundColor: 'rgba(79, 70, 229, 1)',
                pointBorderColor: '#fff',
                pointHoverBackgroundColor: '#fff',
                pointHoverBorderColor: 'rgba(79, 70, 229, 1)'
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: {
                    display: false
                },
                tooltip: {
                    mode: 'index',
                    intersect: false,
                }
            },
            scales: {
                y: {
                    beginAtZero: true,
                    ticks: {
                        stepSize: 1,
                        precision: 0
                    },
                    grid: {
                        borderDash: [2, 4],
                        color: '#e5e7eb'
                    }
                },
                x: {
                    grid: {
                        display: false
                    }
                }
            },
            interaction: {
                mode: 'nearest',
                axis: 'x',
                intersect: false
            }
        }
    });
        }
    });
</script>
{% endblock %}